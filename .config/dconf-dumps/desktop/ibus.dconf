[general]
engines-order=['xkb:no:nodeadkeys:nob', 'mozc-jp', 'xkb:us::eng']
preload-engines=['mozc-jp', 'xkb:us::eng', 'xkb:no:nodeadkeys:nob']
use-global-engine=true
use-system-keyboard-layout=false
version='1.5.32'

[general/hotkey]
triggers=['<Control><Alt>space']

[panel]
show=0

[panel/emoji]
hotkey=@as []
unicode-hotkey=@as []
