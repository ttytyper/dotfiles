#!/usr/bin/env bash
# Launches Rofi to select which web browser to open the given URL in.
# Presents both normal and incognito/private modes.
# For YouTube, mpv is also presented, in both video and audio-only modes.

set -euo pipefail

is_video_site() {
	[[ $1 == http://youtube.com/* ||
	   $1 == https://youtube.com/* ||
	   $1 == http://www.youtube.com/* ||
	   $1 == https://www.youtube.com/* ||
	   $1 == http://youtu.be/* ||
	   $1 == https://youtu.be/* ]]
}

# Opens Qutebrowser as a temporary individual session,
# but retaining your configuration directory.
qutebrowser_private() (
	tmpbase=$(mktemp -d)
	trap 'rm -rf "$tmpbase"' EXIT
	ln -s "$HOME/.config/qutebrowser" "$tmpbase/config"
	opts=(
		--basedir "$tmpbase" 
		# Prevents loading stored session
		--override-restore
		# Can't get dictionaries to be available in the temp session
		-s spellcheck.languages '[]'
		# Adds "(private)" add the end of the window title
		-s window.title_format '{perc}{current_title}{title_sep}qutebrowser (private)'
	)
	exec qutebrowser "${opts[@]}" "$@"
)

list_browsers() {
	if command -v qutebrowser &>/dev/null; then
		printf '%s\n' \
			"qutebrowser" \
			"qutebrowser (private)"
	fi

	if command -v firefox &>/dev/null; then
		printf '%s\n' \
			"firefox" \
			"firefox (private)"
	fi

	if command -v chromium &>/dev/null; then
		printf '%s\n' \
			"chromium" \
			"chromium (private)"
	fi

	if command -v mpv &>/dev/null && [[ ${#@} -gt 0 ]] && is_video_site "$1"; then
		printf '%s\n' \
			"mpv" \
			"mpv (audio only)"
	fi
}

selected=$(
	list_browsers |
		sort |
		rofi -normal-window -no-sort -no-custom -dmenu \
		-p "Select browser"
)

if [[ -z $selected ]]; then
	exit 0
fi

case $selected in
	"qutebrowser")
		exec qutebrowser -- "$@"
		;;
	"qutebrowser (private)")
		qutebrowser_private -- "$@"
		;;
	"firefox")
		exec firefox -- "$@"
		;;
	"firefox (private)")
		exec firefox --new-instance --private-window "$@"
		;;
	"chromium")
		exec chromium -- "$@"
		;;
	"chromium (incognito)")
		exec chromium --incognito -- "$@"
		;;
	"mpv")
		exec mpv --terminal=no -- "$@"
		;;
	"mpv (audio only)")
		exec mpv --terminal=no -no-video -force-window=immediate -- "$@"
		;;
esac
