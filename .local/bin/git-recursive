#!/usr/bin/env bash
# Runs git with the given arguments on all repos under the current directory, recursively

set -uo pipefail

find . \( -name .git -or \( -type f -name HEAD -execdir test -e refs -a -e objects \; \) \) \
	\( \
		-execdir sh -c 'git rev-parse --is-inside-work-tree 2>/dev/null | grep -qF true' \; \
		-or \
		-execdir sh -c 'git rev-parse --is-bare-repository 2>/dev/null | grep -qF true' \; \
	\) \
	-execdir sh -c 'git remote | grep -q .' \; \
	-print0 |
	sort -z |
	while IFS= read -d '' path; do
		repo=$(dirname "$path")
		printf "$(tput bold)Repo: %s$(tput sgr0)\n" "$repo"
		( cd "$repo" && git "$@" )
	done
