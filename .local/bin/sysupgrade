#!/bin/sh

main() {
	set -eux
	sudo apt update
	sudo apt upgrade
	sudo apt autoremove
	sudo apt autoclean
	sudo apt list --upgradable

	if command -v flatpak >/dev/null; then
		sudo flatpak --system uninstall --unused
		sudo flatpak --system update
		sudo flatpak --system uninstall --unused

		flatpak uninstall --unused
		flatpak update
		flatpak uninstall --unused
	fi

	if command -v pipx >/dev/null; then
		sudo pipx --global upgrade-all
		pipx upgrade-all
	fi
}

main "$@"
