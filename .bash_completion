# Let ~/bin/mypass behave as pass
if [ -e "/usr/share/bash-completion/completions/pass" ]; then
	. "/usr/share/bash-completion/completions/pass"
	complete -o filenames -F _pass mypass
fi

# Completion for custom git wrappers
if [ -e "/usr/share/bash-completion/completions/git" ]; then
	. "/usr/share/bash-completion/completions/git"
	if command -v dotfiles >/dev/null; then
		__git_complete dotfiles __git_main
	fi

	if command -v git-recursive >/dev/null; then
		__git_complete git-recursive __git_main
	fi
fi
